PORT=3001
# Supabase: Connect -> Session pooler -> URI (port 5432).
# Copy the exact host/username and URL-encode the database password.
# This is a PostgreSQL URI, not the HTTPS API URL or a Supabase API key.
DATABASE_URL=
# Optional migration-only direct/session URI; defaults to DATABASE_URL.
# Set this if runtime DATABASE_URL uses transaction pooling on port 6543.
DIRECT_URL=
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=1h
CLIENT_URL=http://localhost:3000
# Optional: preserve existing Observe integration when configured.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
# Demo seed only. Required by npm run db:seed, never used by registration.
DEMO_PASSWORD=
