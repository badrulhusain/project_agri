generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  FARMER
  BUYER
  ADMIN
}

enum ProductStatus {
  AVAILABLE
  PARTIALLY_SOLD
  SOLD_OUT
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  email         String?        @unique
  phone         String        @unique
  passwordHash  String
  role          Role
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  farmerProfile FarmerProfile?
  buyerProfile  BuyerProfile?
}

model FarmerProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  state       String?
  district    String?
  address     String?
  primaryCrops String[] @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  orders      Order[]
}

model BuyerProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessName String?
  state       String?
  district    String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
}

model Product {
  id                String        @id @default(uuid()) @db.Uuid
  farmerId          String        @db.Uuid
  farmer            FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  name              String
  category          String
  description       String
  quantity          Decimal       @db.Decimal(14, 3)
  availableQuantity Decimal       @db.Decimal(14, 3)
  unit              String
  pricePerUnit      Decimal       @db.Decimal(12, 2)
  location          String
  images            String[]      @default([])
  status            ProductStatus @default(AVAILABLE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  orderItems        OrderItem[]

  @@index([status, createdAt])
  @@index([farmerId])
  @@index([category])
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  orderNumber     String        @unique @default(uuid())
  buyerId         String        @db.Uuid
  buyer           BuyerProfile  @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  farmerId        String        @db.Uuid
  farmer          FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  totalAmount     Decimal       @db.Decimal(18, 2)
  currency        String        @default("INR")
  status          OrderStatus   @default(PENDING)
  deliveryAddress String
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           OrderItem[]

  @@index([buyerId, createdAt])
  @@index([farmerId, createdAt])
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @db.Uuid
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId   String  @db.Uuid
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String
  unit        String
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(18, 2)

  @@unique([orderId, productId])
  @@index([productId])
}
